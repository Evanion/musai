fragment IdeaBits on Idea {
  id
  title
  body
  status
  createdAt
  project { slug }
  spawnedProject { slug }
}

# `$first` bounds the read as well as the rows. It is deliberately left without a default: discovery reads
# every idea's title to tell what the corpus has already named, and a default bound would silently stop
# seeing past it and file a duplicate. A caller that leaves it out reads every idea, as discovery must.
query AllIdeas($first: Int) {
  ideas(orderBy: [{createdAt: ASC}], first: $first) { ...IdeaBits }
}

query IdeasForProject($slug: String!, $first: Int) {
  ideas(where: {project: {slug: {eq: $slug}}}, orderBy: [{createdAt: ASC}], first: $first) { ...IdeaBits }
}

query IdeaByID($id: ID!) {
  idea(by: {id: $id}) { ...IdeaBits }
}

mutation CreateIdea($title: String!, $body: String, $slug: String!) {
  createIdea(input: {title: $title, body: $body, status: OPEN, project: {connect: {slug: $slug}}}) { id }
}

# A label that never was a working tree becomes an idea with no project: a thread that lived only in
# conversation, and which project — if any — it spun off is the person's call, not discovery's. It is a second
# operation rather than a nullable `$slug` on `CreateIdea`, because NorvoQL refuses a mutation whose input
# branches, so "connect a project only when there is one" cannot be written as one operation.
mutation CreateLooseIdea($title: String!) {
  createIdea(input: {title: $title, status: OPEN}) { id }
}

mutation PromoteIdea($id: ID!, $project: ID!) {
  updateIdea(by: {id: $id}, set: {status: {set: PROMOTED}, spawnedProject: {connect: {id: $project}}}) { id status }
}

# An idea dropped in the corrective surface is deleted, not parked: a `DROPPED` status would need someone to
# read it and would leave the row in `AllIdeas`, and nothing references an idea, so there is no history a
# delete could strand.
mutation DropIdea($id: ID!) {
  deleteIdea(by: {id: $id})
}
