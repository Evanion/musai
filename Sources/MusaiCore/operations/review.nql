fragment DecisionBits on Decision {
  id
  title
  rationale
  act
  state
  origin
  settledAt
  persistedAt
  document { id }
  documentRef
  subject { id }
  utterance { id text at speaker }
  project { slug }
}

query PendingDecisions($first: Int = 50) {
  decisions(where: {state: {eq: PROPOSED}}, orderBy: [{createdAt: ASC}], first: $first) { ...DecisionBits }
}

query UnpersistedDecisions($first: Int = 50) {
  decisions(where: {state: {eq: SETTLED}}, orderBy: [{createdAt: ASC}], first: $first) { ...DecisionBits }
}

# Migrated proposals are in their own state so they never sit in `PendingDecisions` in front of live review.
query MigratedDecisions($first: Int = 50) {
  decisions(where: {state: {eq: MIGRATED}}, orderBy: [{createdAt: ASC}], first: $first) { ...DecisionBits }
}

query DecisionByID($id: ID!) {
  decision(by: {id: $id}) { ...DecisionBits }
}

# The queue event a decision was filed under: a replayed drain finds it already filed and skips it.
query DecisionByOrigin($origin: String!) {
  decisions(where: {origin: {eq: $origin}}, first: 1) { id }
}

query DecisionsForProject($slug: String!, $first: Int = 50) {
  decisions(
    where: {project: {slug: {eq: $slug}}, state: {in: [SETTLED, PERSISTED]}}
    orderBy: [{createdAt: ASC}], first: $first) { ...DecisionBits }
}

mutation RecordProposal($title: String!, $rationale: String, $act: ActKind!, $utterance: ID!, $project: String!, $origin: String) {
  createDecision(input: {
    title: $title
    rationale: $rationale
    act: $act
    state: PROPOSED
    utterance: {connect: {id: $utterance}}
    project: {connect: {slug: $project}}
    origin: $origin
  }) { id }
}

# An imported one-sided decision: it has no utterance to point at, and its state is MIGRATED, so it is
# proposed to nobody. `origin` is required because it is what a replayed import dedupes on.
mutation RecordMigratedProposal($title: String!, $rationale: String, $act: ActKind!, $origin: String!, $slug: String!) {
  createDecision(input: {
    title: $title
    rationale: $rationale
    act: $act
    state: MIGRATED
    project: {connect: {slug: $slug}}
    origin: $origin
  }) { id }
}

# The same for an observation under a session that resolved to no project. Separate for the reason
# `RecordMemoryUnbound` is: a oneOf input refuses a nullable variable.
mutation RecordMigratedProposalUnbound($title: String!, $rationale: String, $act: ActKind!, $origin: String!) {
  createDecision(input: {
    title: $title
    rationale: $rationale
    act: $act
    state: MIGRATED
    origin: $origin
  }) { id }
}

mutation SettleDecision($id: ID!, $settledAt: DateTime!) {
  updateDecision(by: {id: $id}, set: {
    state: {set: SETTLED}
    settledAt: {set: $settledAt}
  }) { id state }
}

mutation PersistDecisionInDocument($id: ID!, $document: ID!, $persistedAt: DateTime!) {
  updateDecision(by: {id: $id}, set: {
    state: {set: PERSISTED}
    document: {connect: {id: $document}}
    persistedAt: {set: $persistedAt}
  }) { id state }
}

mutation PersistDecisionOutside($id: ID!, $documentRef: String!, $persistedAt: DateTime!) {
  updateDecision(by: {id: $id}, set: {
    state: {set: PERSISTED}
    documentRef: {set: $documentRef}
    persistedAt: {set: $persistedAt}
  }) { id state }
}

mutation DropProposal($id: ID!) {
  deleteDecision(by: {id: $id})
}
