fragment MemoryBits on Memory {
  id
  kind
  origin
  text
  narrative
  concepts
  provenance
  createdAt
  project { slug }
  session { id memorySessionId startedAt }
  subject { id }
}

# `$first` bounds the read as well as the rows: a caller that leaves it out reads the whole project, which
# is what the slice must not do on `SessionStart`. The slice names its own window; see `MusaiSlice.render`.
query MemoriesForProject($slug: String!, $first: Int) {
  memories(where: {project: {slug: {eq: $slug}}}, orderBy: [{createdAt: DESC}], first: $first) { ...MemoryBits }
}

query MemoriesOfKind($kind: MemoryKind!) {
  memories(where: {kind: {eq: $kind}}, orderBy: [{createdAt: DESC}]) { ...MemoryBits }
}

query MemoryByProvenance($provenance: String!) {
  memories(where: {provenance: {eq: $provenance}}, first: 1) { ...MemoryBits }
}

# Most of an imported corpus predates any project: `project: null` is what makes it reachable.
query MemoriesWithoutProject($first: Int = 200) {
  memories(where: {project: null}, orderBy: [{createdAt: DESC}], first: $first) { ...MemoryBits }
}

query MemoryByID($id: ID!) {
  memory(by: {id: $id}) { ...MemoryBits embedding }
}

mutation RecordMemory($kind: MemoryKind!, $origin: MemoryOrigin!, $text: String, $narrative: String, $concepts: [String!], $provenance: String, $slug: String!) {
  createMemory(input: {
    kind: $kind
    origin: $origin
    text: $text
    narrative: $narrative
    concepts: $concepts
    provenance: $provenance
    project: {connect: {slug: $slug}}
  }) { id }
}

# Imported evidence for a session that resolved to a project: it binds to that project and to its session.
mutation RecordMemoryForSession($kind: MemoryKind!, $origin: MemoryOrigin!, $text: String, $narrative: String, $concepts: [String!], $provenance: String, $slug: String!, $memorySessionId: String!) {
  createMemory(input: {
    kind: $kind
    origin: $origin
    text: $text
    narrative: $narrative
    concepts: $concepts
    provenance: $provenance
    project: {connect: {slug: $slug}}
    session: {connect: {memorySessionId: $memorySessionId}}
  }) { id }
}

# The same evidence for a session that resolved to no project. A separate operation because NorvoQL
# refuses a nullable variable in a oneOf input, so "bind only when there is a slug" cannot be one write.
mutation RecordMemoryUnbound($kind: MemoryKind!, $origin: MemoryOrigin!, $text: String, $narrative: String, $concepts: [String!], $provenance: String, $memorySessionId: String!) {
  createMemory(input: {
    kind: $kind
    origin: $origin
    text: $text
    narrative: $narrative
    concepts: $concepts
    provenance: $provenance
    session: {connect: {memorySessionId: $memorySessionId}}
  }) { id }
}

mutation AttachMemoryToSubject($id: ID!, $subject: ID!) {
  updateMemory(by: {id: $id}, set: {subject: {connect: {id: $subject}}}) { id }
}

mutation SetMemorySession($id: ID!, $memorySessionId: String!) {
  updateMemory(by: {id: $id}, set: {session: {connect: {memorySessionId: $memorySessionId}}}) { id }
}

mutation EmbedMemory($id: ID!, $embedding: Vector!) {
  updateMemory(by: {id: $id}, set: {embedding: {set: $embedding}}) { id }
}

mutation DeleteMemory($id: ID!) {
  deleteMemory(by: {id: $id})
}
