fragment ProjectBits on Project {
  id
  name
  slug
  status
  summary
  repoRemote
  rootPath
  createdAt
  updatedAt
}

fragment UtteranceBits on Utterance {
  id
  text
  at
  speaker
  origin
  session { id memorySessionId }
}

fragment EventBits on Event {
  id
  kind
  text
  tool
  target
  digest
  at
  drained
}
