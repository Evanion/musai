fragment TaskBits on Task {
  id
  title
  detail
  status
  position
  createdAt
  project { slug }
  plan { id title }
}

query TasksForPlan($plan: ID!) {
  tasks(where: {plan: {id: {eq: $plan}}}, orderBy: [{position: ASC}, {createdAt: ASC}]) { ...TaskBits }
}

# `$first` bounds the read as well as the rows: a caller that leaves it out reads every task of the status,
# which the slice must not pay for on `SessionStart`. The slice names its own window; see `MusaiSlice.render`.
query TasksForProjectByStatus($slug: String!, $status: TaskStatus!, $first: Int) {
  tasks(where: {project: {slug: {eq: $slug}}, status: {eq: $status}}, orderBy: [{position: ASC}], first: $first) { ...TaskBits }
}

mutation CreateTask($title: String!, $detail: String, $position: Int, $plan: ID!, $slug: String!) {
  createTask(input: {title: $title, detail: $detail, status: TODO, position: $position, project: {connect: {slug: $slug}}, plan: {connect: {id: $plan}}}) { id }
}

mutation SetTaskStatus($id: ID!, $status: TaskStatus!) {
  updateTask(by: {id: $id}, set: {status: {set: $status}}) { id status }
}
