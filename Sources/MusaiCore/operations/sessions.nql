fragment SessionBits on Session {
  id
  memorySessionId
  platform
  cwd
  title
  status
  startedAt
  endedAt
  project { slug }
}

query ProjectByRemote($remote: String!) {
  projects(where: {repoRemote: {eq: $remote}}, first: 1) { id slug name }
}

query ProjectByRoot($root: String!) {
  projects(where: {rootPath: {eq: $root}}, first: 1) { id slug name }
}

query SessionByMemoryId($memorySessionId: String!) {
  session(by: {memorySessionId: $memorySessionId}) { ...SessionBits }
}

mutation UpsertSession($memorySessionId: String!, $platform: String!, $cwd: String, $title: String, $status: SessionStatus = ACTIVE, $startedAt: DateTime!, $slug: String!) {
  upsertSession(by: {memorySessionId: $memorySessionId}, input: {
    memorySessionId: $memorySessionId
    platform: $platform
    cwd: $cwd
    title: $title
    status: $status
    startedAt: $startedAt
    project: {connect: {slug: $slug}}
  }) { id }
}

# An imported session whose cwd resolved to no project — 838 of the corpus's 956. It still has to exist,
# because its evidence and prompts are written through it.
mutation UpsertSessionUnbound($memorySessionId: String!, $platform: String!, $cwd: String, $title: String, $status: SessionStatus = ACTIVE, $startedAt: DateTime!) {
  upsertSession(by: {memorySessionId: $memorySessionId}, input: {
    memorySessionId: $memorySessionId
    platform: $platform
    cwd: $cwd
    title: $title
    status: $status
    startedAt: $startedAt
  }) { id }
}

mutation EndSession($memorySessionId: String!, $status: SessionStatus!, $endedAt: DateTime!) {
  updateSession(by: {memorySessionId: $memorySessionId}, set: {status: {set: $status}, endedAt: {set: $endedAt}}) { id status }
}
